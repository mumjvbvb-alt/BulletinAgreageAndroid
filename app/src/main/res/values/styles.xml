<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BulletinAgreage" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">serif</item>
        <item name="android:colorAccent">#333333</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="BulletinLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:padding">5dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="BulletinInput">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:padding">4dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:background">#FFFFFF</item>
    </style>
    <style name="BulletinHead">
        <item name="android:layout_width">125dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:padding">5dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">#D9D9D9</item>
    </style>
    <style name="BulletinCell">
        <item name="android:layout_width">210dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">5dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">10sp</item>
    </style>
    <style name="BulletinSection">
        <item name="android:layout_width">210dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">5dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="BulletinLimit">
        <item name="android:layout_width">115dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">10sp</item>
    </style>
    <style name="BulletinValue">
        <item name="android:layout_width">100dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">11sp</item>
        <item name="android:inputType">numberDecimal</item>
    </style>
    <style name="BulletinCalc">
        <item name="android:layout_width">105dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">10sp</item>
    </style>
    <style name="BulletinObs">
        <item name="android:layout_width">105dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">9sp</item>
    </style>
    <style name="BulletinGroup">
        <item name="android:layout_width">125dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:padding">4dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>