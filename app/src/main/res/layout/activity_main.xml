<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#E9E9E9">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:padding="8dp" android:layout_marginBottom="8dp"
            android:background="#FFFFFF">
            <TextView android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:gravity="center_vertical"
                android:text="État du produit :" android:textStyle="bold"
                android:textSize="15sp" android:textColor="#111111"/>
            <Spinner android:id="@+id/statut" android:layout_width="0dp"
                android:layout_height="48dp" android:layout_weight="1.25"
                android:entries="@array/statut_options"
                android:background="@drawable/control_field"
                android:paddingStart="10dp" android:paddingEnd="10dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:padding="6dp" android:layout_marginBottom="8dp"
            android:background="#FFFFFF">
            <TextView
                android:layout_width="wrap_content" android:layout_height="44dp"
                android:gravity="center_vertical"
                android:text="حجم الخط:" android:textStyle="bold"
                android:textSize="14sp" android:textColor="#111111"/>
            <Button
                android:id="@+id/fontMinus" android:layout_width="48dp" android:layout_height="44dp"
                android:text="−" android:textSize="20sp"
                android:background="@drawable/control_button"/>
            <TextView
                android:id="@+id/fontSizeValue" android:layout_width="48dp" android:layout_height="44dp"
                android:gravity="center" android:text="10"
                android:textStyle="bold" android:textSize="15sp" android:textColor="#111111"/>
            <Button
                android:id="@+id/fontPlus" android:layout_width="48dp" android:layout_height="44dp"
                android:text="+" android:textSize="20sp"
                android:background="@drawable/control_button"/>
            <Button
                android:id="@+id/fontReset" android:layout_width="wrap_content" android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:text="افتراضي" android:textSize="12sp"
                android:background="@drawable/control_button"/>
        </LinearLayout>
        <com.example.bulletinagreage.BulletinPageLayout
            android:id="@+id/bulletinPage" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:elevation="2dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="10dp" android:layout_marginTop="8dp"
            android:background="#FFFFFF">
            <EditText android:id="@+id/differencePrix" android:layout_width="match_parent"
                android:layout_height="46dp" android:hint="Différence prix blé dur / blé tendre (DA/q), si nécessaire"
                android:inputType="numberDecimal" android:paddingStart="12dp" android:paddingEnd="12dp"
                android:textSize="14sp" android:background="@drawable/control_field" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                android:orientation="horizontal" android:layout_marginTop="8dp">
                <Button android:id="@+id/calculer" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:text="CALCULER" android:textStyle="bold"
                    android:textSize="13sp" android:background="@drawable/control_button" />
                <Space android:layout_width="8dp" android:layout_height="1dp" />
                <Button android:id="@+id/genererPdf" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:text="GÉNÉRER PDF" android:textStyle="bold"
                    android:textSize="13sp" android:background="@drawable/control_button" />
            </LinearLayout>
            <TextView android:id="@+id/resultat" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp" android:padding="12dp"
                android:textSize="13sp" android:textColor="#111111" android:background="#F7F7F7" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="Décret n°88-152 du 26 juillet 1988"
                android:textSize="10sp" android:textColor="#555555" android:gravity="center" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>